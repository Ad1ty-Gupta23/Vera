ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
AGENT_CONFIDENCE_THRESHOLD=0.65

# Google Places API (New) + Geocoding API — https://console.cloud.google.com
# Enable: Places API (New) AND Geocoding API
# Restrict key to both APIs
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Search radius configuration
DEFAULT_SEARCH_RADIUS_METERS=5000
MAX_SEARCH_RADIUS_METERS=25000

# --- Business knowledge base / RAG (Stage 4) ---
# No API key needed — embeddings run locally via sentence-transformers.
# First run downloads the model from Hugging Face (needs outbound internet
# once); after that it's cached on disk and works offline.
CHROMA_PERSIST_DIR=./chroma_data
KB_EMBEDDING_MODEL=all-MiniLM-L6-v2
KB_MAX_FILE_SIZE_MB=15
KB_CHUNK_SIZE_CHARS=1200
KB_CHUNK_OVERLAP_CHARS=200
KB_RETRIEVAL_TOP_K=4
KB_MAX_RELEVANT_DISTANCE=0.8

# --- Auth + persistence (Stage 2) ---
# Missing from this file until Stage 6 — these were already read by
# app/config/settings.py but never documented here. Create an OAuth 2.0
# Client ID (type "Web application") at https://console.cloud.google.com,
# with http://localhost:8000/api/auth/google/callback as an authorized
# redirect URI (and see GOOGLE_GMAIL_REDIRECT_URI below for the second one
# Stage 6 needs on the same client).
DATABASE_URL=sqlite:///./vera.db
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
SESSION_SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173

# --- Gmail integration / issue-report workflow (Stage 6) ---
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above — this is a second,
# separate OAuth *client registration* against the same Google Cloud
# project, requesting the narrower gmail.send scope with offline access.
# In Google Cloud Console, add this as an additional Authorized redirect
# URI on the same OAuth client used for login.
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8000/api/gmail/callback

# Fernet key used to encrypt the Gmail refresh token at rest. Generate one
# with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MUST be set for Gmail connect to work — there is no insecure default.
TOKEN_ENCRYPTION_KEY=
